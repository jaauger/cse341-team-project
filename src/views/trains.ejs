<%- include('./partials/header') %>

<section class="trains-hero">
    <h1>Learn about our Trains</h1>
    <p>
        Explore the physical trains that power scenic the trips across the Kizuna Rail network.
    </p>
</section>

<section class="trains-catalog">

        <form class="trains-controls" id="trains-controls">

        <div class="trains-control-group trains-search-group">
            <label for="trains-search">Search Trains</label>
            <input
                type="search"
                id="trains-search"
                name="search"
                placeholder="Search by name, operator, type..."
                autocomplete="off">
        </div>

        <div class="trains-control-group">
            <label for="trains-type">Train Type</label>
            <select id="trains-type" name="type">
                <option value="">All Types</option>
            </select>
        </div>

        <div class="trains-control-group">
            <label for="trains-power-source">Power Source</label>
            <select id="trains-power-source" name="powerSource">
                <option value="">All Power Sources</option>
            </select>
        </div>

        <div class="trains-control-group">
            <label for="trains-sort-by">Sort By</label>
            <select id="trains-sort-by" name="sortBy">
                <option value="name">Train Name</option>
                <option value="operator">Operator</option>
                <option value="maxSpeedKmh">Maximum Speed</option>
                <option value="capacity">Passenger Capacity</option>
            </select>
        </div>

        <div class="trains-control-group">
            <label for="trains-sort-order">Sort Order</label>
            <select id="trains-sort-order" name="sortOrder">
                <option value="asc">Ascending</option>
                <option value="desc">Descending</option>
            </select>
        </div>

        <div class="trains-control-actions">
            <button type="submit" id="trains-apply">
                Apply
            </button>

            <button type="reset" id="trains-reset">
                Reset
            </button>
        </div>

    </form>

    <div class="trains-state" id="trains-loading">Loading trains...</div>
    <div class="trains-state trains-error" id="trains-error" hidden></div>

    <p class="trains-results-summary"
       id="trains-results-summary"
       aria-live="polite"></p>

    <div class="trains-grid" id="trains-list"></div>

    <div class="trains-state" id="trains-empty" hidden>
        No trains match your search or filter criteria.
        Try adjusting your selections.
    </div>

    <nav class="trains-pagination"
         id="trains-pagination"
         aria-label="Train catalog pagination"
         hidden>

        <button type="button" id="trains-prev" disabled>
            Previous
        </button>

        <span id="trains-page-info" aria-live="polite">
            Page 1 of 1
        </span>

        <button type="button" id="trains-next" disabled>
            Next
        </button>

    </nav>

    <template id="train-card-template">
        <article class="train-card">
            <div class="train-image-wrap">
                <img data-field="image" loading="lazy" decoding="async">
            </div>

            <header class="train-card-header">
                <h2 data-field="name"></h2>
                <span class="train-operator" data-field="operator"></span>
            </header>

            <p class="train-description" data-field="description"></p>

            <dl class="train-specs">
                <div class="spec-item">
                    <dt>Type</dt>
                    <dd data-field="type"></dd>
                </div>
                <div class="spec-item">
                    <dt>Top Speed</dt>
                    <dd data-field="speed"></dd>
                </div>
                <div class="spec-item">
                    <dt>Capacity</dt>
                    <dd data-field="seats"></dd>
                </div>
                <div class="spec-item">
                    <dt>Power</dt>
                    <dd data-field="power"></dd>
                </div>
            </dl>

            <p class="train-best-for">
                <strong>Best For:</strong>
                <span data-field="best-for"></span>
            </p>
        </article>
    </template>
</section>

<script src="/js/trains.js" defer></script>

<%- include('./partials/footer') %>
