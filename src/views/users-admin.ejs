<%- include('./partials/header') %>

<section class="users-hero" id="users-page" data-is-admin="<%= isAdmin ? 'true' : 'false' %>">
    <h1>User Management</h1>
    <p>View account information and manage user.</p>
</section>

<section class="users-catalog">
    <% if (isAdmin) { %>
        <form class="users-controls" id="users-controls">
            <div class="users-control-group">
                <label for="users-search">Search users</label>
                <input
                    type="search"
                    id="users-search"
                    name="search"
                    maxlength="50"
                    placeholder="Search name, username, or email..."
                    autocomplete="off">
            </div>

            <div class="users-control-group">
                <label for="users-role">Filter by role</label>
                <select id="users-role" name="role">
                    <option value="">All roles</option>
                    <option value="customer">Customer</option>
                    <option value="admin">Admin</option>
                </select>
            </div>

            <div class="users-control-group">
                <label for="users-sort-order">Sort usernames</label>
                <select id="users-sort-order" name="sortOrder">
                    <option value="asc">A to Z</option>
                    <option value="desc">Z to A</option>
                </select>
            </div>

            <div class="users-control-actions">
                <button type="submit" id="users-apply">
                    Apply
                </button>
                <button type="reset" id="users-reset">
                    Reset
                </button>
            </div>
        </form>
    <% } %>

    <div class="users-state" id="users-loading" aria-live="polite">
        Loading users...
    </div>
    <div class="users-state users-error" id="users-error" role="alert" hidden></div>
    <div class="users-state" id="users-success" aria-live="polite" hidden></div>
    <div class="users-state" id="users-empty" aria-live="polite" hidden>
        No users found.
    </div>

    <p class="users-results-summary" id="users-results-summary" aria-live="polite" hidden></p>

    <div class="users-grid" id="users-list"></div>

    <nav class="users-pagination"
         id="users-pagination"
         aria-label="User list pagination"
         hidden>
        <button type="button" id="users-prev" disabled>
            Previous
        </button>

        <span id="users-page-info" aria-live="polite">
            Page 1 of 1
        </span>

        <button type="button" id="users-next" disabled>
            Next
        </button>
    </nav>

    <template id="user-card-template">
        <article class="user-card">
            <div class="user-card-header">
                <h2 data-field="display-name"></h2>
                <span class="user-role" data-field="role"></span>
            </div>

            <dl class="user-details">
                <div class="detail-item">
                    <dt>Username</dt>
                    <dd data-field="username"></dd>
                </div>
                <div class="detail-item">
                    <dt>Email</dt>
                    <dd data-field="email"></dd>
                </div>
            </dl>

            <div class="user-actions" data-field="actions" hidden>
                <label>
                    Role
                    <select data-field="role-select">
                        <option value="customer">Customer</option>
                        <option value="admin">Admin</option>
                    </select>
                </label>
                <button type="button" data-action="delete">Delete user</button>
            </div>
        </article>
    </template>
</section>

<script src="/js/users-admin.js" defer></script>
<%- include('./partials/footer') %>
